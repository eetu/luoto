{
    "version": "@VERSION@",
    "description": "Create and manage supply-chain-safe dev sandboxes",
    "homepage": "https://github.com/@REPO@",
    "license": "MIT",
    "notes": "luoto needs a container runtime: podman or Docker. Then run: luoto setup",
    "architecture": {
        "64bit": {
            "url": "https://github.com/@REPO@/releases/download/v@VERSION@/luoto-@VERSION@-x86_64-pc-windows-msvc.zip",
            "hash": "@SHA_x86_64-pc-windows-msvc@",
            "extract_dir": "luoto-@VERSION@-x86_64-pc-windows-msvc"
        }
    },
    "bin": "luoto.exe",
    "checkver": {
        "github": "https://github.com/@REPO@"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/@REPO@/releases/download/v$version/luoto-$version-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS",
                    "regex": "$sha256\\s+$basename"
                },
                "extract_dir": "luoto-$version-x86_64-pc-windows-msvc"
            }
        }
    }
}
